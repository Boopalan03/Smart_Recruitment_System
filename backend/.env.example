# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Replace with cloud MongoDB URI such as MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/job-portal?retryWrites=true&w=majority

# JWT Security Key
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL (for CORS protection)
FRONTEND_URL=https://your-frontend-domain.vercel.app
